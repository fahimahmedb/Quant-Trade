{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProspectiveContract",
  "type": "object",
  "required": ["prediction_id","prediction_version","hypothesis_generation_id","prediction","outcome_definition","observation_horizon","primary_metric","decision_map","falsification_scope","frozen_at","content_hash","evidence_timing","prospective_integrity","observation_authorization"],
  "properties": {
    "prediction_id": {"type":"string","minLength":1},
    "prediction_version": {"type":"integer","minimum":1},
    "hypothesis_generation_id": {"type":"string","minLength":1},
    "prediction": {"type":"string","minLength":1},
    "outcome_definition": {"type":"string","minLength":1},
    "observation_horizon": {"type":"string","minLength":1},
    "universe_or_population": {"type":["string","null"]},
    "eligibility_rules": {"type":"array","items":{"type":"string"}},
    "primary_metric": {"type":"string","minLength":1},
    "authorized_secondary_metrics": {"type":"array","items":{"type":"string"}},
    "cost_assumption_ref": {"type":["string","null"]},
    "decision_map": {"type":"array","items":{"type":"object","required":["outcome","action"],"properties":{"outcome":{"type":"string"},"action":{"enum":["KILL","PARK","EXPLORE","PROMOTE","NO_OPPORTUNITY"]}},"additionalProperties":false}},
    "falsification_scope": {"type":"string","minLength":1},
    "evidence_target": {"type":["string","null"]},
    "frozen_at": {"type":"string","minLength":1},
    "content_hash": {"type":"string","minLength":1},
    "input_availability_check": {"enum":["PASS","FAIL","NOT_ASSESSED"]},
    "outcome_availability_check": {"enum":["PASS","FAIL","NOT_ASSESSED"]},
    "evidence_timing": {"enum":["RETROSPECTIVE","PROSPECTIVE","UNDETERMINED"]},
    "prospective_integrity": {"enum":["PASS","FAIL","NOT_ASSESSED","NOT_APPLICABLE"]},
    "observation_authorization": {"type":"object","required":["status"],"properties":{"status":{"enum":["NOT_AUTHORIZED","AUTHORIZED_FOR_EXACT_SCOPE"]},"scope":{"type":["string","null"]}},"additionalProperties":false}
  },
  "additionalProperties": false
}
