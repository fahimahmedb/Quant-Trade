{
  "contract_version": 1,
  "status": "ACTIVE_METHOD",
  "authorities": {
    "project_branch": "project/canonical",
    "code_branch": "code/canonical",
    "project_router": "governance/CURRENT_PROJECT_STATE.md",
    "method_document": "governance/AI_WORKING_METHOD_V1.md"
  },
  "two_branch_mode": "MIGRATING",
  "allowed_outcomes": [
    "NO_CHANGE_REQUIRED",
    "REUSE",
    "CONNECT",
    "REPAIR",
    "BUILD_REQUIRED",
    "PASS",
    "FAIL",
    "PARK",
    "BLOCK",
    "UNKNOWN",
    "BLOCK_EVIDENCE"
  ],
  "mission_required_fields": [
    "current_subject",
    "current_blocker_or_decision",
