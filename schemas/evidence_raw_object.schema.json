{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawObject",
  "description": "One acquisition receipt for immutable content-addressed raw bytes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "source_uri": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "receipt_id": {"type": "string", "pattern": "^receipt:[0-9a-f]{64}$"}
  },
  "required": ["sha256", "size_bytes", "source_uri", "retrieved_at", "media_type", "source_type", "receipt_id"]
}
