{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "One open position inside a ledger.",
  "properties": {
    "average_price": {
      "type": "number"
    },
    "last_price": {
      "type": "number"
    },
    "opened_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "realized_pnl": {
      "type": "number"
    },
    "strategy_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "strategy_id"
  ],
  "title": "position",
  "type": "object"
}
