{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DerivedArtifact",
  "description": "Replayable lineage from ordered input evidence hashes through a versioned transform to an output hash.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^artifact:[0-9a-f]{64}$"},
    "input_sha256s": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "transform_name": {"type": "string", "minLength": 1},
    "transform_version": {"type": "string", "minLength": 1},
    "output_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parameters": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "required": ["artifact_id", "input_sha256s", "transform_name", "transform_version", "output_sha256", "parameters", "created_at"]
}
