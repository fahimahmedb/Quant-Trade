{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "evidence_hashes": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "listing_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "valid_from": {
      "type": "string"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "venue": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "security_id",
    "venue",
    "valid_from",
    "valid_to",
    "evidence_hashes"
  ],
  "title": "ListingInterval",
  "type": "object"
}
