{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment_registry.json",
  "title": "Quant Experiment Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "experiment_key", "version", "lane", "status", "dataset_refs", "protocol", "protocol_hash"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-F0-9]{16}$"},
    "experiment_key": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "lane": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "PREREGISTERED", "DATA_READY", "BLUE_FROZEN", "TESTING", "PROMISING", "REJECT", "INSUFFICIENT", "RETIRED"]},
    "dataset_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "version", "content_hash", "role"],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "role": {"enum": ["formation", "outcome", "benchmark", "synthetic"]}
        }
      }
    },
    "protocol": {"$ref": "experiment_preregistration.json"},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}