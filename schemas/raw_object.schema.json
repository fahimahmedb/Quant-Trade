{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "media_type": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^receipt:[0-9a-f]{64}$",
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "source_type": {
      "minLength": 1,
      "type": "string"
    },
    "source_uri": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "sha256",
    "size_bytes",
    "source_uri",
    "retrieved_at",
    "media_type",
    "source_type",
    "receipt_id"
  ],
  "title": "RawObject",
  "type": "object"
}
