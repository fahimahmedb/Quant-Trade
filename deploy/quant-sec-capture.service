# SEC/Form-4 P0 acquisition service.
#
# The restart semantics below are acquisition-critical: they decide the expected
# acquisition timeline after a failure, so this file is digested into
# ACQUISITION_CRITICAL_FINGERPRINT and a change to it resets t0.
#
# The unit launches the supervisor, not the collector. The supervisor classifies
# why each collector instance started, which the collector is not permitted to
# do for itself.
#
# QUANT_SEC_USER_AGENT must carry a requester name and contact address. Without
# it the lane fails closed and makes no SEC request. It is supplied through an
# environment file that is NOT committed to the repository.

[Unit]
Description=Quant SEC/Form-4 P0 acquisition service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/quant
EnvironmentFile=/etc/quant/sec-capture.env
# Declares which service manager is launching this. systemd additionally supplies
# INVOCATION_ID per unit invocation, which a hand-typed command does not carry.
# Both are required before a run may call itself qualifying, so a human who simply
# omits a flag is recorded as MANUAL_START rather than SCHEDULED_START.
Environment=QUANT_SEC_SERVICE_MANAGER=systemd
# --qualifying refuses every acquisition-critical override: cadence comes from the
# frozen policy and a qualifying service does not stop after N idle waits.
ExecStart=/usr/bin/python3 /opt/quant/deploy/quant_sec_supervisor.py --root /opt/quant --qualifying
Restart=no
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=30
KillSignal=SIGTERM\nKillMode=control-group\nUMask=0077\nNoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
