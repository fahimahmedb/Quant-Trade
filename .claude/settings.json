{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "ultracode": true,
  "workflowSizeGuideline": "small",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/fast_rail_checkpoint.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/fast_rail_checkpoint.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/fast_rail_checkpoint.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
