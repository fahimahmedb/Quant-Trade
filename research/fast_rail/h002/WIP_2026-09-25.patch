+            if best is None:
+                self.assertFalse(_nonzero(weights))
+                continue
+            side = 1.0 if best[1] > 0 else -1.0
+            self.assertEqual(weights, {f"HL.{best[0]}": -side * 0.05,
+                                       f"BY.{best[0]}": side * 0.05})
+
+    def test_short_leg_on_the_venue_whose_longs_pay_receives_funding(self):
