+class MakerFee(unittest.TestCase):
+    def test_zero_for_taker_only_fee_type(self):
+        self.assertEqual(a.maker_fee_dollars(0.50, 100, "quadratic", 1), 0.0)
+
+    def test_ceil_to_cent_with_multiplier(self):
+        # raw = 0.0175 * 1 * 100 * 0.5 * 0.5 = 0.4375 -> ceil to 0.44
+        self.assertAlmostEqual(a.maker_fee_dollars(0.50, 100, "quadratic_with_maker_fees", 1), 0.44)
+        # raw = 0.0175 * 0.5 * 100 * 0.5 * 0.5 = 0.21875 -> ceil to 0.22
+        self.assertAlmostEqual(a.maker_fee_dollars(0.50, 100, "quadratic_with_maker_fees", 0.5), 0.22)
+
+    def test_fee_is_subtracted_and_doubles(self):
+        u = a.MarketUnit("Sports", "T-1", "EV-1", 0.0)
+        a.process_market(u, [P(0, 0.50, 100, "yes")], "no", "quadratic_with_maker_fees", 1)
+        fee_pc = 0.44 / 100.0
+        self.assertAlmostEqual(u.per_contract("settlement", 0.0), 0.50)
+        self.assertAlmostEqual(u.per_contract("settlement"), 0.50 - fee_pc)
+        self.assertAlmostEqual(u.per_contract("settlement", 2.0), 0.50 - 2 * fee_pc)
+
