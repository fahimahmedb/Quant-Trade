+++ b/research/fast_rail/h010/fetch.py
@@ -0,0 +1,207 @@
+"""H-010 trade fetch: every print for the frozen sample (data/fast_rail/h010/markets.jsonl.gz).
+
+Public, unauthenticated Kalshi endpoints only. A single global rate limiter (shared across
+worker threads) keeps requests paced; 429s are slept through and retried, never bypassed.
+/historical/cutoff decides, per market, whether /historical/trades alone suffices (its
+close_time is at or before the cutoff, so every print necessarily predates it) or whether
+/markets/trades must also be queried (the market may have kept trading past the cutoff);
+results from both are merged and de-duplicated by trade_id.
+
+Huge-volume rule, stated and committed BEFORE any KPI is computed (config.CAP_PRINTS_PER_MARKET
+= 2000): keep only the first 2000 prints in chronological order per market.
+
+Storage (data/fast_rail/h010/):
+  trades_<CATEGORY>.jsonl.gz  one line per sampled market: ticker, n_prints (kept),
+                              n_prints_total (before the cap), fee_type/fee_multiplier,
+                              prints stored column-wise (t = epoch-ms deltas, p = YES price
+                              in 1e-4 $, c = contracts x100, s = taker_side "y"/"n"),
+                              plus provenance (urls sample, page count, fetched_at, sha256
+                              of the raw page bodies).
+  manifest.json               sha256 of every stored file + fetch parameters.
+
+Progress is checkpointed under data/fast_rail/h010/raw/ (gitignored) so a re-run resumes
+without re-fetching markets already done.
+
+Usage: python3 research/fast_rail/h010/fetch.py
+"""
+from __future__ import annotations
+
+import datetime as dt
+import gzip
+import hashlib
+import json
+import os
+import sys
+import threading
+import time
+import urllib.error
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import config  # noqa: E402
+
+BASE = "https://api.elections.kalshi.com/trade-api/v2"
+ROOT = Path(__file__).resolve().parents[3]
+OUT = ROOT / "data" / "fast_rail" / "h010"
+RAW = OUT / "raw"
+PROGRESS = RAW / "trades_progress.jsonl"
+MIN_INTERVAL_S = 1.0 / 6.0  # <= 6 requests/second across all threads (matches H-004)
+
+_lock = threading.Lock()
+_last = [0.0]
+_series_fee_cache: dict[str, dict] = {}
+_series_lock = threading.Lock()
+
+
+def get(path: str) -> tuple[dict, bytes]:
+    for attempt in range(10):
+        with _lock:
+            wait = _last[0] + MIN_INTERVAL_S - time.monotonic()
+            if wait > 0:
+                time.sleep(wait)
+            _last[0] = time.monotonic()
+        try:
+            with urllib.request.urlopen(BASE + path, timeout=60) as r:
+                body = r.read()
+            return json.loads(body), body
+        except urllib.error.HTTPError as e:
+            if e.code == 404:
+                return {}, b""
+            time.sleep(5 * (attempt + 1) if e.code == 429 else min(30, 2 ** attempt))
+        except Exception:
+            time.sleep(min(30, 2 ** attempt))
+    raise RuntimeError(f"failed: {path}")
+
+
+def series_fee(series_ticker: str) -> dict:
+    """fee_type/fee_multiplier for a series, fetched once and cached (small, fixed set)."""
+    with _series_lock:
+        if series_ticker in _series_fee_cache:
+            return _series_fee_cache[series_ticker]
+    d, _ = get(f"/series/{series_ticker}")
+    info = {"fee_type": d.get("series", {}).get("fee_type"),
+            "fee_multiplier": d.get("series", {}).get("fee_multiplier")}
+    with _series_lock:
+        _series_fee_cache[series_ticker] = info
+    return info
+
+
+def fetch_trades(market: dict, cutoff_ts: float) -> dict:
+    use_historical = True
+    use_live = market["close_ts"] > cutoff_ts
+    urls, h, by_id = [], hashlib.sha256(), {}
+    for prefix, flag in (("/historical/trades", use_historical), ("/markets/trades", use_live)):
+        if not flag:
+            continue
+        cursor = ""
+        while True:
+            q = f"{prefix}?ticker={market['ticker']}&limit=1000" + (f"&cursor={cursor}" if cursor else "")
+            d, body = get(q)
+            urls.append(BASE + q)
+            h.update(body)
+            tr = d.get("trades", [])
+            for t in tr:
+                by_id[t["trade_id"]] = t
+            cursor = d.get("cursor")
+            if not cursor or not tr:
+                break
+    rows = sorted(by_id.values(), key=lambda t: t["created_time"])
+    n_total = len(rows)
+    rows = rows[:config.CAP_PRINTS_PER_MARKET]
+    fee = series_fee(market["series_ticker"])
+    t_delta, prev, p, c, s = [], 0, [], [], []
+    for t in rows:
+        ts_ms = int(dt.datetime.fromisoformat(t["created_time"].replace("Z", "+00:00")).timestamp() * 1000)
+        t_delta.append(ts_ms - prev)
+        prev = ts_ms
+        p.append(round(float(t["yes_price_dollars"]) * 1e4))
+        c.append(round(float(t["count_fp"]) * 100))
+        s.append("y" if t["taker_side"] == "yes" else "n")
+    return {"ticker": market["ticker"], "event_ticker": market["event_ticker"],
+            "category": market["category"], "series_ticker": market["series_ticker"],
+            "result": market["result"], "close_time": market["close_time"],
+            "fee_type": fee["fee_type"], "fee_multiplier": fee["fee_multiplier"],
+            "n_prints": len(rows), "n_prints_total": n_total, "capped": n_total > len(rows),
+            "t": t_delta, "p": p, "c": c, "s": "".join(s),
+            "provenance": {"urls_sample": urls[:2], "n_pages": len(urls),
+                           "fetched_at": dt.datetime.now(dt.timezone.utc).isoformat(),
+                           "sha256_raw_pages": h.hexdigest()}}
+
+
+def load_sample() -> list[dict]:
+    with gzip.open(OUT / "markets.jsonl.gz", "rt") as f:
+        return [json.loads(line) for line in f]
+
+
+def load_progress() -> dict[str, dict]:
+    done: dict[str, dict] = {}
+    if PROGRESS.exists():
+        with PROGRESS.open() as f:
+            for line in f:
+                r = json.loads(line)
+                done[r["ticker"]] = r
+    return done
+
+
+def sha256_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> None:
+    RAW.mkdir(parents=True, exist_ok=True)
+    cutoff, _ = get("/historical/cutoff")
+    cutoff_ts = dt.datetime.fromisoformat(cutoff["trades_created_ts"].replace("Z", "+00:00")).timestamp()
+    sample = load_sample()
+    done = load_progress()
+    todo = [m for m in sample if m["ticker"] not in done]
+    print(f"sample {len(sample)} markets, {len(done)} already fetched, {len(todo)} to go", flush=True)
+    if todo:
+        pfh = PROGRESS.open("a")
+        plock = threading.Lock()
+        n = [0]
+
+        def work(m: dict) -> None:
+            rec = fetch_trades(m, cutoff_ts)
+            with plock:
+                pfh.write(json.dumps(rec, separators=(",", ":")) + "\n")
+                pfh.flush()
+                n[0] += 1
+                if n[0] % 50 == 0:
+                    print(n[0], "/", len(todo), flush=True)
+
+        with ThreadPoolExecutor(6) as ex:
+            list(ex.map(work, todo))
+        pfh.close()
+        done = load_progress()
+
+    OUT.mkdir(parents=True, exist_ok=True)
+    by_cat: dict[str, list[dict]] = {c: [] for c in config.CATEGORIES}
+    for m in sample:
+        rec = done.get(m["ticker"])
+        if rec is not None:
+            by_cat[m["category"]].append(rec)
+    files: dict[str, dict] = {}
+    for cat, recs in by_cat.items():
+        recs.sort(key=lambda r: r["ticker"])
+        path = OUT / f"trades_{cat}.jsonl.gz"
+        tmp = path.with_suffix(".tmp")
+        with gzip.open(tmp, "wt", compresslevel=9) as f:
+            for r in recs:
+                f.write(json.dumps(r, separators=(",", ":")) + "\n")
+        os.replace(tmp, path)
+        files[path.name] = {"sha256": sha256_file(path), "bytes": path.stat().st_size, "n_markets": len(recs)}
+        print(cat, "markets", len(recs), "prints", sum(r["n_prints"] for r in recs),
+              "bytes", files[path.name]["bytes"], flush=True)
+    manifest = {"hypothesis": config.HYPOTHESIS_ID, "dataset_key": config.DATASET_KEY,
+                "base_url": BASE, "cutoff": cutoff, "cap_prints_per_market": config.CAP_PRINTS_PER_MARKET,
+                "window": [config.WINDOW_START.isoformat(), config.WINDOW_END.isoformat()],
+                "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(), "files": files,
+                "total_bytes": sum(v["bytes"] for v in files.values())}
+    (OUT / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n")
+    print("total bytes", manifest["total_bytes"])
+
+
+if __name__ == "__main__":
+    main()
