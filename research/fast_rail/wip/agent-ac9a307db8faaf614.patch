+class VerdictCauses(unittest.TestCase):
+    def _base(self, **over):
+        d = {"t_net": config.REQUIRED_T + 1, "n": config.MARKETS_NEEDED_MARKOUT + 10,
+             "mean_net_fee2x_c": 1.0, "half_means_c": [1.0, 1.0], "top_decile_share": 0.2}
+        d.update(over)
+        return d
+
+    def test_candidate_when_everything_passes(self):
+        level, causes = a.verdict_for_category(self._base())
+        self.assertEqual(level, "CANDIDATE")
+        self.assertEqual(causes, [])
+
+    def test_signal_cause_below_required_t(self):
+        level, causes = a.verdict_for_category(self._base(t_net=0.1))
+        self.assertEqual(level, "REJECT")
+        self.assertIn("SIGNAL", causes)
+
+    def test_signal_cause_when_a_half_is_negative(self):
+        level, causes = a.verdict_for_category(self._base(half_means_c=[1.0, -1.0]))
+        self.assertEqual(level, "REJECT")
+        self.assertIn("SIGNAL", causes)
+
+    def test_power_cause_when_n_below_registered_threshold(self):
+        level, causes = a.verdict_for_category(self._base(n=5))
+        self.assertEqual(level, "REJECT")
+        self.assertIn("POWER", causes)
+
+    def test_costs_cause_when_2x_fees_flip_sign(self):
+        level, causes = a.verdict_for_category(self._base(mean_net_fee2x_c=-0.5))
+        self.assertEqual(level, "REJECT")
+        self.assertIn("COSTS", causes)
+
+    def test_concentration_cause_when_top_decile_dominates(self):
+        level, causes = a.verdict_for_category(self._base(top_decile_share=0.9))
+        self.assertEqual(level, "REJECT")
+        self.assertIn("CONCENTRATION", causes)
+
+
+if __name__ == "__main__":
+    unittest.main()
