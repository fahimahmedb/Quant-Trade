+"""Offline adversarial tests for fast-rail H-010 (Kalshi maker rent by category).
+
+All fixture numbers and tickers are INVENTED for testing and are not market data.
+"""
+from __future__ import annotations
+
+import importlib.util
+import random
+import sys
+import unittest
+from pathlib import Path
+
+_DIR = Path(__file__).resolve().parents[1] / "research" / "fast_rail" / "h010"
+sys.path.insert(0, str(_DIR))
+
+
+def _load(name: str, filename: str):
+    spec = importlib.util.spec_from_file_location(name, _DIR / filename)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+config = _load("h010_config", "config.py")
+a = _load("h010_analysis", "analysis.py")
+s = _load("h010_sample", "sample.py")
+
+P = a.Print
+
+
+class MarkoutReferenceWindow(unittest.TestCase):
+    """The reference must never use prints before t+1h or at/after t+2h."""
+
+    def test_never_uses_prints_before_t_plus_3600(self):
+        # INVENTED: prints at +0, +1000, +3599.999 are extreme and must be ignored.
+        ps = [P(0, 0.50, 1, "yes"), P(1000, 0.99, 50, "no"), P(3599.999, 0.01, 50, "yes"),
+              P(3600, 0.60, 2, "yes"), P(5000, 0.70, 2, "no"), P(7199.999, 0.20, 6, "no")]
+        ref = a.markout_reference(ps, [p.t for p in ps], 0)
+        # only [3600, 7200) counts: (0.60*2 + 0.70*2 + 0.20*6) / 10
+        self.assertAlmostEqual(ref, (0.60 * 2 + 0.70 * 2 + 0.20 * 6) / 10.0)
+
+    def test_window_excludes_t_plus_7200_exactly(self):
+        ps = [P(0, 0.50, 1, "yes"), P(7200, 0.90, 1, "no")]
+        self.assertIsNone(a.markout_reference(ps, [p.t for p in ps], 0))
+
+    def test_window_includes_t_plus_3600_exactly(self):
+        ps = [P(0, 0.50, 1, "yes"), P(3600, 0.42, 1, "no")]
+        self.assertAlmostEqual(a.markout_reference(ps, [p.t for p in ps], 0), 0.42)
+
+
+class MakerSign(unittest.TestCase):
+    def test_taker_sells_yes_maker_bought_yes(self):
+        # taker_side "no": taker bought NO -> maker bought YES at 0.30
+        self.assertAlmostEqual(a.maker_pnl(0.30, 1.0, "no"), 0.70)
+        self.assertAlmostEqual(a.maker_pnl(0.30, 0.0, "no"), -0.30)
+
+    def test_taker_buys_yes_maker_sold_yes(self):
+        # taker_side "yes": taker bought YES -> maker sold YES at 0.30
+        self.assertAlmostEqual(a.maker_pnl(0.30, 0.0, "yes"), 0.30)
+        self.assertAlmostEqual(a.maker_pnl(0.30, 1.0, "yes"), -0.70)
+
+    def test_invalid_side_raises(self):
+        with self.assertRaises(ValueError):
+            a.maker_sign("buy")
+
+
+class NoFillIn(unittest.TestCase):
+    def test_no_later_print_skips_markout_never_imputed(self):
+        u = a.MarketUnit("Sports", "T-1", "EV-1", 0.0)
+        # second print has no [t+1h, t+2h) follower at all
+        a.process_market(u, [P(0, 0.40, 10, "no"), P(50, 0.45, 10, "yes")], None, "quadratic", 1)
+        self.assertIsNone(u.per_contract("markout"))
+        self.assertIsNone(u.per_contract("settlement"))  # unknown result: no settlement either
+
+    def test_settlement_still_computed_when_markout_has_no_fill(self):
+        u = a.MarketUnit("Sports", "T-1", "EV-1", 0.0)
+        a.process_market(u, [P(0, 0.40, 10, "no")], "yes", "quadratic", 1)
+        self.assertIsNone(u.per_contract("markout"))  # no later print at all
+        self.assertAlmostEqual(u.per_contract("settlement", 0.0), 0.60)  # maker bought YES at .40, settles 1
+
+    def test_partial_fill_only_qualifying_prints_skipped(self):
+        u = a.MarketUnit("Sports", "T-1", "EV-1", 0.0)
+        # print 0 has a follower in-window (print 1); print 1 (t=4000) does not.
+        a.process_market(u, [P(0, 0.50, 1, "no"), P(4000, 0.60, 1, "no")], None, "quadratic", 1)
+        self.assertEqual(u.sums["markout"]["c"], 1.0)  # only print 0 contributed
+
+
+class OneMarketPerEvent(unittest.TestCase):
+    def _rows(self):
+        # INVENTED: event EV-A has 3 candidate markets, EV-B has 1.
+        return [
+            {"event_ticker": "EV-A", "ticker": "A-1", "category": "Sports"},
+            {"event_ticker": "EV-A", "ticker": "A-2", "category": "Sports"},
+            {"event_ticker": "EV-A", "ticker": "A-3", "category": "Sports"},
+            {"event_ticker": "EV-B", "ticker": "B-1", "category": "Sports"},
+        ]
+
+    def test_exactly_one_row_per_event(self):
+        sample = s.pick_sample(self._rows(), seed=1, max_events=100)
+        events = [r["event_ticker"] for r in sample]
+        self.assertEqual(sorted(events), ["EV-A", "EV-B"])
+        self.assertEqual(len(sample), len(set(events)))
+
+    def test_chosen_market_is_one_of_the_events_own_candidates(self):
+        sample = s.pick_sample(self._rows(), seed=1, max_events=100)
+        chosen_a = next(r["ticker"] for r in sample if r["event_ticker"] == "EV-A")
+        self.assertIn(chosen_a, {"A-1", "A-2", "A-3"})
+
+
+class SamplingReproducible(unittest.TestCase):
+    def _rows(self, n_events=20, seed=99):
+        rng = random.Random(seed)
+        rows = []
+        for i in range(n_events):
+            n_markets = rng.randint(1, 3)
+            for j in range(n_markets):
+                rows.append({"event_ticker": f"EV-{i:03d}", "ticker": f"EV-{i:03d}-M{j}",
+                            "category": "World"})
+        return rows
+
+    def test_same_seed_same_result_regardless_of_input_order(self):
+        rows = self._rows()
+        shuffled = rows[:]
+        random.Random(7).shuffle(shuffled)
+        out1 = s.pick_sample(rows, seed=config.SEED, max_events=10)
+        out2 = s.pick_sample(shuffled, seed=config.SEED, max_events=10)
+        self.assertEqual(out1, out2)
+
+    def test_declared_seed_reproduces_across_independent_calls(self):
+        rows = self._rows()
+        out1 = s.pick_sample(rows, seed=config.SEED, max_events=10)
+        out2 = s.pick_sample(rows, seed=config.SEED, max_events=10)
+        self.assertEqual(out1, out2)
+        self.assertEqual(len(out1), 10)
+
+    def test_caps_at_max_events_and_is_a_true_subset(self):
+        rows = self._rows(n_events=50)
+        sample = s.pick_sample(rows, seed=config.SEED, max_events=12)
+        self.assertEqual(len(sample), 12)
+        all_events = {r["event_ticker"] for r in rows}
+        self.assertTrue({r["event_ticker"] for r in sample} <= all_events)
+
+    def test_below_cap_takes_every_event(self):
+        rows = self._rows(n_events=5)
+        sample = s.pick_sample(rows, seed=config.SEED, max_events=400)
+        self.assertEqual(len(sample), 5)
+
+
+class QualifyingRowFilter(unittest.TestCase):
+    def test_settled_in_window_with_volume_qualifies(self):
+        event = {"category": "Sports", "series_ticker": "KXFAKE", "event_ticker": "EV-1"}
+        start, end = 1000, 2000
+        good = {"ticker": "M-1", "status": "finalized", "result": "yes",
+                "close_time": "1970-01-01T00:25:00Z", "volume_fp": "5.0"}  # ts=1500
+        row = s.qualifying_row(event, good, start, end)
+        self.assertIsNotNone(row)
+        self.assertEqual(row["ticker"], "M-1")
