@@ -0,0 +1,246 @@
+"""H-010 analysis: Kalshi maker rent by category.
+
+Measurement only, paper/shadow. Pure functions (tested offline in
+tests/test_fast_rail_h010.py) plus ``main`` which reads the stored sample under
+data/fast_rail/h010/ and writes results.json. No discovery/validation split: the registry
+falsification is evaluated once on the whole sampled window (no free parameter).
+
+Sign convention (taker_side is the AGGRESSOR's side): taker_side "no" means the taker
+bought NO, so the maker (resting order) bought YES at p -> maker P&L = ref - p. taker_side
+"yes" means the maker sold YES at p -> maker P&L = p - ref.
+"""
+from __future__ import annotations
+
+import bisect
+import datetime as dt
+import gzip
+import json
+import math
+import statistics
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import config  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[3]
+DATA = ROOT / "data" / "fast_rail" / "h010"
+
+
+@dataclass(frozen=True)
+class Print:
+    t: float          # epoch seconds
+    price: float      # YES price, dollars
+    count: float      # contracts
+    taker_side: str   # "yes" | "no"
+
+
+def maker_sign(taker_side: str) -> int:
+    """+1 if the maker bought YES (taker sold YES / bought NO), -1 if the maker sold YES."""
+    if taker_side == "no":
+        return 1
+    if taker_side == "yes":
+        return -1
+    raise ValueError(taker_side)
+
+
+def maker_pnl(price: float, reference: float, taker_side: str) -> float:
+    return maker_sign(taker_side) * (reference - price)
+
+
+def _ceil_cent(dollars: float) -> float:
+    """Round up to the nearest cent, tolerant of float noise on exact-cent amounts."""
+    cents = round(dollars * 100, 6)
+    return math.ceil(cents) / 100.0
+
+
+def maker_fee_dollars(price: float, contracts: float, fee_type: str | None,
+                       fee_multiplier: float | None) -> float:
+    """Total (not per-contract) maker fee for one print. 0 unless the series' fee_type is
+    one that charges makers (config.MAKER_FEE_TYPES); see config.py for the empirical
+    fee_type survey behind this assumption."""
+    if fee_type not in config.MAKER_FEE_TYPES:
+        return 0.0
+    mult = fee_multiplier if fee_multiplier is not None else 1.0
+    raw = config.MAKER_FEE_RATE * mult * contracts * price * (1.0 - price)
+    return _ceil_cent(raw)
+
+
+def markout_reference(prints: list[Print], times: list[float], i: int,
+                       start_s: float = config.MARKOUT_START_S,
+                       end_s: float = config.MARKOUT_END_S) -> float | None:
+    """VWAP of the same market's prints in [t_i + start, t_i + end); None if none (no fill-in:
+    a print with no later same-market print in that window is simply skipped, never imputed)."""
+    t0 = prints[i].t
+    lo = bisect.bisect_left(times, t0 + start_s)
+    hi = bisect.bisect_left(times, t0 + end_s)
+    num = den = 0.0
+    for j in range(lo, hi):
+        num += prints[j].price * prints[j].count
+        den += prints[j].count
+    return num / den if den > 0 else None
+
+
+@dataclass
+class MarketUnit:
+    """One sampled market == one event (the sample is one market per event by construction,
+    so clustering by market and clustering by event coincide)."""
+    category: str
+    ticker: str
+    event_ticker: str
+    close_ts: float
+    sums: dict = field(default_factory=dict)
+
+    def add(self, key: str, contracts: float, gross: float, fee: float) -> None:
+        s = self.sums.setdefault(key, {"c": 0.0, "gross": 0.0, "fee": 0.0})
+        s["c"] += contracts
+        s["gross"] += gross * contracts
+        s["fee"] += fee * contracts
+
+    def per_contract(self, key: str, fee_mult: float = 1.0) -> float | None:
+        s = self.sums.get(key)
+        if not s or s["c"] <= 0:
+            return None
+        return (s["gross"] - fee_mult * s["fee"]) / s["c"]
+
+    def dollars(self, key: str, fee_mult: float = 1.0) -> float:
+        s = self.sums.get(key)
+        return 0.0 if not s else s["gross"] - fee_mult * s["fee"]
+
+
+def process_market(unit: MarketUnit, prints: list[Print], result: str | None,
+                    fee_type: str | None, fee_multiplier: float | None) -> None:
+    prints = sorted(prints, key=lambda p: p.t)
+    times = [p.t for p in prints]
+    settle = {"yes": 1.0, "no": 0.0}.get(result or "")
+    for i, p in enumerate(prints):
+        fee_total = maker_fee_dollars(p.price, p.count, fee_type, fee_multiplier)
+        fee_pc = fee_total / p.count if p.count > 0 else 0.0
+        if settle is not None:
+            unit.add("settlement", p.count, maker_pnl(p.price, settle, p.taker_side), fee_pc)
+        ref = markout_reference(prints, times, i)
+        if ref is None:
+            continue  # no same-market print in [t+1h, t+2h): skipped, never filled in
+        unit.add("markout", p.count, maker_pnl(p.price, ref, p.taker_side), fee_pc)
+
+
+def t_stat(xs: list[float]) -> float:
+    if len(xs) < 2:
+        return 0.0
+    sd = statistics.stdev(xs)
+    return statistics.fmean(xs) / (sd / math.sqrt(len(xs))) if sd > 0 else 0.0
+
+
+def evaluate(units: list[MarketUnit], key: str) -> dict:
+    us = sorted((u for u in units if u.per_contract(key) is not None), key=lambda u: u.close_ts)
+    x1 = [u.per_contract(key) for u in us]
+    x2 = [u.per_contract(key, 2.0) for u in us]
+    x0 = [u.per_contract(key, 0.0) for u in us]
+    out = {"n": len(us),
+           "mean_gross_c": 100 * statistics.fmean(x0) if x0 else None,
+           "mean_net_c": 100 * statistics.fmean(x1) if x1 else None,
+           "mean_net_fee2x_c": 100 * statistics.fmean(x2) if x2 else None,
+           "stdev_net_c": 100 * statistics.stdev(x1) if len(x1) > 1 else None,
+           "t_net": t_stat(x1), "t_net_fee2x": t_stat(x2),
+           "contracts": sum(u.sums[key]["c"] for u in us)}
+    half = len(us) // 2
+    out["half_means_c"] = [100 * statistics.fmean(x1[:half]) if x1[:half] else None,
+                           100 * statistics.fmean(x1[half:]) if x1[half:] else None]
+    dollars = sorted((u.dollars(key) for u in us), reverse=True)
+    total = sum(dollars)
+    k = max(1, math.ceil(0.10 * len(dollars))) if dollars else 0
+    out["top_decile_share"] = (sum(dollars[:k]) / total) if total > 0 else None
+    return out
+
+
+def verdict_for_category(markout: dict) -> tuple[str, list[str]]:
+    """Registry falsification, evaluated once (no discovery split). Returns (level, causes).
+
+    The registry's four explicit gates are t/2x-fees/halves/top-decile. POWER (n below the
+    registry's own pre-registered markets_needed_markout=58) additionally gates CANDIDATE
+    here, not just labels a cause: per FAST_RAIL_STATE.md's standing lesson ("the bottleneck
+    is the power of the test, not the trial count") and H-003's precedent (a mechanically
+    "passing" but degenerate/underpowered t was still REJECTed), a "significant" t from an
+    underpowered sample is not treated as a trustworthy CANDIDATE.
+    """
+    causes = []
+    t_ok = markout["t_net"] >= config.REQUIRED_T
+    halves_ok = all((h or 0) > 0 for h in markout["half_means_c"])
+    if not t_ok or not halves_ok:
+        causes.append("SIGNAL")
+    power_ok = markout["n"] >= config.MARKETS_NEEDED_MARKOUT
+    if not power_ok:
+        causes.append("POWER")
+    fee2x_ok = (markout["mean_net_fee2x_c"] or 0) > 0
+    if t_ok and not fee2x_ok:
+        causes.append("COSTS")
+    conc_ok = markout["top_decile_share"] is not None and markout["top_decile_share"] < config.MAX_TOP_DECILE_SHARE
+    if not conc_ok:
+        causes.append("CONCENTRATION")
+    level = "CANDIDATE" if (t_ok and halves_ok and fee2x_ok and conc_ok and power_ok) else "REJECT"
+    return level, causes
+
+
+def decode(rec: dict) -> list[Print]:
+    out, t = [], 0
+    for dtm, p, c, s in zip(rec["t"], rec["p"], rec["c"], rec["s"]):
+        t += dtm
+        out.append(Print(t / 1000.0, p / 1e4, c / 100.0, "yes" if s == "y" else "no"))
+    return out
+
+
+def load() -> tuple[list[dict], dict[str, dict]]:
+    with gzip.open(DATA / "markets.jsonl.gz", "rt") as f:
+        markets = [json.loads(line) for line in f]
+    trades: dict[str, dict] = {}
+    for cat in config.CATEGORIES:
+        path = DATA / f"trades_{cat}.jsonl.gz"
+        if not path.exists():
+            continue
+        with gzip.open(path, "rt") as f:
+            for line in f:
+                rec = json.loads(line)
+                trades[rec["ticker"]] = rec
+    return markets, trades
+
+
+def build_units(markets: list[dict], trades: dict[str, dict]) -> list[MarketUnit]:
+    units = []
+    for m in markets:
+        rec = trades.get(m["ticker"])
+        if rec is None:
+            continue
+        u = MarketUnit(m["category"], m["ticker"], m["event_ticker"],
+                       dt.datetime.fromisoformat(m["close_time"].replace("Z", "+00:00")).timestamp())
+        process_market(u, decode(rec), rec.get("result"), rec.get("fee_type"), rec.get("fee_multiplier"))
+        units.append(u)
+    return units
+
+
+def main() -> None:
+    markets, trades = load()
+    units = build_units(markets, trades)
+    res: dict = {"hypothesis": config.HYPOTHESIS_ID, "trials": config.TRIALS,
+                 "required_t": config.REQUIRED_T, "categories": {}}
+    for cat in config.CATEGORIES:
+        us = [u for u in units if u.category == cat]
+        markout = evaluate(us, "markout")
+        settlement = evaluate(us, "settlement")
+        level, causes = verdict_for_category(markout)
+        res["categories"][cat] = {
+            "n_markets_with_trades": len(us),
+            "markout": markout,
+            "settlement": settlement,
+            "assumed_sigma_markout_c": config.ASSUMED_SIGMA_MARKOUT_C,
+            "power_flag_markout": markout["n"] < config.MARKETS_NEEDED_MARKOUT,
+            "power_flag_settlement": settlement["n"] < config.EVENTS_NEEDED_SETTLEMENT,
+            "verdict": level, "causes": causes,
+        }
+    out = Path(__file__).resolve().parent / "results.json"
+    out.write_text(json.dumps(res, indent=1, default=str) + "\n")
+    print(json.dumps(res, indent=1, default=str))
+
+
+if __name__ == "__main__":
+    main()
