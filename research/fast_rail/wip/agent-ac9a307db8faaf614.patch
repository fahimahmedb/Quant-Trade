index 0000000..3534877
--- /dev/null
+++ b/research/fast_rail/h010/sample.py
@@ -0,0 +1,252 @@
+"""H-010 sampling: settled markets by category, decided from market METADATA ONLY.
+
+No trade print is read anywhere in this file. Three phases, run in order:
+
+  python3 research/fast_rail/h010/sample.py index    # paginate /events WITHOUT nested
+                                                       # markets (light payload) for the
+                                                       # whole window; keep (event_ticker,
+                                                       # category, series_ticker) for our
+                                                       # 3 categories
+  python3 research/fast_rail/h010/sample.py detail    # for each qualifying event ticker
+                                                       # from `index`, fetch its markets
+                                                       # (with_nested_markets=true) and keep
+                                                       # the ones that qualify
+  python3 research/fast_rail/h010/sample.py build     # group by event, apply the declared
+                                                       # seeded sampling rule, write the
+                                                       # frozen sample
+
+Each phase is resumable (checkpointed cursor / done-set) and idempotent. Raw output lives
+under data/fast_rail/h010/raw/ (gitignored: data/fast_rail/*/raw/); only `build`'s output
+(the frozen sample) is committed.
+
+Kalshi does not let /events filter by category server-side (checked empirically: passing
+category=<x> returns identical results regardless of <x>), so every settled event in the
+window must be scanned and category read from the event's own (authoritative) `category`
+field. Doing that scan WITHOUT nested markets first (this is what made a first attempt with
+with_nested_markets=true directly degrade to several seconds/page: a minority of events --
+large multi-leg combo/exotic products -- carry huge nested-market arrays) keeps each index
+page small and fast; the heavier per-event detail fetch then only runs for the events that
+are actually in Sports/Entertainment/World.
+"""
+from __future__ import annotations
+
+import datetime as dt
+import gzip
+import hashlib
+import json
+import random
+import sys
+import threading
+import time
+import urllib.error
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import config  # noqa: E402
+
+BASE = "https://api.elections.kalshi.com/trade-api/v2"
+ROOT = Path(__file__).resolve().parents[3]
+OUT = ROOT / "data" / "fast_rail" / "h010"
+RAW = OUT / "raw"
+IDX_CKPT = RAW / "index_checkpoint.json"
+IDX_JL = RAW / "events_index.jsonl"
+DETAIL_DONE = RAW / "detail_done.jsonl"
+EVENTS_JL = RAW / "events_settled.jsonl"
+
+_interval = [0.15]  # adaptive, only ever grows (never bypass 429; see _get)
+_lock = threading.Lock()
+
+
+def _get(path: str) -> dict:
+    for attempt in range(12):
+        with _lock:
+            time.sleep(_interval[0])
+        try:
+            with urllib.request.urlopen(BASE + path, timeout=30) as r:
+                return json.loads(r.read())
+        except urllib.error.HTTPError as e:
+            if e.code == 429:
+                with _lock:
+                    _interval[0] = min(5.0, _interval[0] * 1.5 + 0.15)
+                time.sleep(3 * (attempt + 1))
+                continue
+            time.sleep(min(20, 2 ** attempt))
+        except Exception:
+            time.sleep(min(20, 2 ** attempt))
+    raise RuntimeError("failed: " + path)
+
+
+def _parse_ts(s: str) -> float:
+    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
+
+
+def qualifying_row(event: dict, market: dict, start_ts: int, end_ts: int) -> dict | None:
+    """Pure predicate + projection: metadata-only (no trade endpoint touched).
+
+    ">=1 trade" is read off ``volume_fp`` (contracts traded to date): it is a running
+    count derived from the exchange's own trade log and cannot be > 0 with zero prints.
+    """
+    if market.get("status") not in config.SETTLED_STATUSES:
+        return None
+    if market.get("result") not in config.SETTLED_RESULTS:
+        return None
+    ct = market.get("close_time")
+    if not ct:
+        return None
+    ts = _parse_ts(ct)
+    if not (start_ts <= ts < end_ts):
+        return None
+    vol = float(market.get("volume_fp") or 0)
+    if vol <= 0:
+        return None
+    return {
+        "category": event["category"],
+        "series_ticker": event.get("series_ticker"),
+        "event_ticker": event["event_ticker"],
+        "ticker": market["ticker"],
+        "close_time": ct,
+        "close_ts": ts,
+        "volume_fp": vol,
+        "result": market["result"],
+        "status": market["status"],
+    }
+
+
+def index_events() -> None:
+    """Phase 1: light (no nested markets) full scan of settled events in the window."""
+    RAW.mkdir(parents=True, exist_ok=True)
+    start_ts, end_ts = config.window_ts()
+    ckpt = {"cursor": "", "pages": 0, "events_scanned": 0,
+            "kept": {c: 0 for c in config.CATEGORIES}}
+    if IDX_CKPT.exists():
+        ckpt = json.loads(IDX_CKPT.read_text())
+    fh = IDX_JL.open("a")
+    t0 = time.monotonic()
+    while True:
+        q = (f"/events?status=settled&min_close_ts={start_ts}&max_close_ts={end_ts}"
+             f"&with_nested_markets=false&limit=200")
+        if ckpt["cursor"]:
+            q += f"&cursor={ckpt['cursor']}"
+        d = _get(q)
+        evs = d.get("events", [])
+        for ev in evs:
+            cat = ev.get("category")
+            if cat in config.CATEGORIES:
+                fh.write(json.dumps({"event_ticker": ev["event_ticker"], "category": cat,
+                                     "series_ticker": ev.get("series_ticker")},
+                                    sort_keys=True) + "\n")
+                ckpt["kept"][cat] += 1
+        ckpt["events_scanned"] += len(evs)
+        ckpt["pages"] += 1
+        fh.flush()
+        cursor = d.get("cursor")
+        ckpt["cursor"] = cursor or ""
+        IDX_CKPT.write_text(json.dumps(ckpt))
+        if ckpt["pages"] % 20 == 0:
+            print(ckpt["pages"], "pages", ckpt["events_scanned"], "events scanned",
+                  ckpt["kept"], round(time.monotonic() - t0, 1), "s", flush=True)
+        if not cursor or not evs:
+            break
+    fh.close()
+    print("INDEX DONE", json.dumps(ckpt), flush=True)
+
+
+def fetch_detail() -> None:
+    """Phase 2: for each qualifying event ticker, fetch its markets and filter."""
+    start_ts, end_ts = config.window_ts()
+    wanted: dict[str, dict] = {}
+    with IDX_JL.open() as f:
+        for line in f:
+            r = json.loads(line)
+            wanted[r["event_ticker"]] = r
+    done = set()
+    if DETAIL_DONE.exists():
+        with DETAIL_DONE.open() as f:
+            for line in f:
+                done.add(json.loads(line)["event_ticker"])
+    todo = [et for et in wanted if et not in done]
+    print(f"{len(wanted)} qualifying events, {len(done)} already fetched, {len(todo)} to go", flush=True)
+    dfh = DETAIL_DONE.open("a")
+    efh = EVENTS_JL.open("a")
+    plock = threading.Lock()
+    n = [0]
+
+    def work(et: str) -> None:
+        d = _get(f"/events/{et}?with_nested_markets=true")
+        ev = d.get("event", {})
+        rows = [qualifying_row(ev, m, start_ts, end_ts) for m in ev.get("markets", [])]
+        rows = [r for r in rows if r is not None]
+        with plock:
+            for r in rows:
+                efh.write(json.dumps(r, sort_keys=True) + "\n")
+            efh.flush()
+            dfh.write(json.dumps({"event_ticker": et, "n_kept": len(rows)}) + "\n")
+            dfh.flush()
+            n[0] += 1
+            if n[0] % 100 == 0:
+                print(n[0], "/", len(todo), flush=True)
+
+    with ThreadPoolExecutor(6) as ex:
+        list(ex.map(work, todo))
+    dfh.close()
+    efh.close()
+    print("DETAIL DONE", n[0], "events fetched", flush=True)
+
+
+def pick_sample(rows: list[dict], seed: int = config.SEED,
+                 max_events: int = config.MAX_EVENTS_PER_CATEGORY) -> list[dict]:
+    """Declared rule: ONE market per event (uniform, random.Random(seed)), then at most
+    ``max_events`` events (uniform, same seed). Deterministic regardless of input order."""
+    by_event: dict[str, list[dict]] = {}
+    for r in rows:
+        by_event.setdefault(r["event_ticker"], []).append(r)
+    events = sorted(by_event)
+    rng1 = random.Random(seed)
+    chosen = {ev: rng1.choice(sorted(by_event[ev], key=lambda r: r["ticker"])) for ev in events}
+    rng2 = random.Random(seed)
+    sampled_events = rng2.sample(events, max_events) if len(events) > max_events else events
+    return [chosen[ev] for ev in sorted(sampled_events)]
+
+
+def build_sample() -> dict:
+    rows_by_cat: dict[str, list[dict]] = {c: [] for c in config.CATEGORIES}
+    events_by_cat: dict[str, set] = {c: set() for c in config.CATEGORIES}
+    with EVENTS_JL.open() as f:
+        for line in f:
+            r = json.loads(line)
+            c = r["category"]
+            if c in rows_by_cat:
+                rows_by_cat[c].append(r)
+                events_by_cat[c].add(r["event_ticker"])
+    OUT.mkdir(parents=True, exist_ok=True)
+    summary = {"hypothesis": config.HYPOTHESIS_ID, "dataset_key": config.DATASET_KEY,
+               "window": [config.WINDOW_START.isoformat(), config.WINDOW_END.isoformat()],
+               "seed": config.SEED, "max_events_per_category": config.MAX_EVENTS_PER_CATEGORY,
+               "categories": {}}
+    all_sampled: list[dict] = []
+    for c in config.CATEGORIES:
+        sample = pick_sample(rows_by_cat[c])
+        summary["categories"][c] = {
+            "n_qualifying_markets": len(rows_by_cat[c]),
+            "n_qualifying_events": len(events_by_cat[c]),
+            "n_sampled_events": len(sample),
+        }
+        all_sampled.extend(sample)
+    all_sampled.sort(key=lambda r: (r["category"], r["ticker"]))
+    path = OUT / "markets.jsonl.gz"
+    tmp = path.with_suffix(".tmp")
+    with gzip.open(tmp, "wt", compresslevel=9) as f:
+        for r in all_sampled:
+            f.write(json.dumps(r, sort_keys=True) + "\n")
+    tmp.replace(path)
+    summary["sha256_markets_jsonl_gz"] = hashlib.sha256(path.read_bytes()).hexdigest()
+    summary["generated_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
+    (OUT / "sample_summary.json").write_text(json.dumps(summary, indent=1) + "\n")
+    print(json.dumps(summary, indent=1))
+    return summary
+
+
+if __name__ == "__main__":
+    {"index": index_events, "detail": fetch_detail, "build": build_sample}[sys.argv[1]]()
