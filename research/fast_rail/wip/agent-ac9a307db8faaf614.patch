@@ -0,0 +1,67 @@
+"""H-010 frozen design. Declared in research/fast_rail/registry.jsonl (id "H-010", event
+"declared", 2026-09-27T10:00:00Z) BEFORE any market or trade was read. Nothing here may
+change after sampling runs; a change is a rerun and consumes trials.
+
+Grid, sampling rule, KPI and thresholds are copied verbatim from that registry line; this
+file only turns them into runnable constants. See RESULT.md for the fee_type/fee_multiplier
+survey that backs the maker-fee assumption below.
+"""
+from __future__ import annotations
+
+import datetime as dt
+
+HYPOTHESIS_ID = "H-010"
+DATASET_KEY = "kalshi_trades_by_category_2026h2"
+DECLARED_TRIALS = 3
+RERUNS = 0  # bump on every rerun after a bug fix; TRIALS = DECLARED_TRIALS + RERUNS
+TRIALS = DECLARED_TRIALS + RERUNS
+REQUIRED_T = 2.394  # required_t_statistic(3) (quant.factory.evaluate); checked in tests
+
+CATEGORIES = ("Sports", "Entertainment", "World")  # Kalshi event/series `category`, verbatim
+
+WINDOW_START = dt.date(2026, 4, 17)
+WINDOW_END = dt.date(2026, 9, 26)  # inclusive
+
+SEED = 20260927
+MAX_EVENTS_PER_CATEGORY = 400
+
+# "Settled markets ... with >= 1 trade", decided from market METADATA only, before any
+# trade print is read: volume_fp > 0 is the metadata-only proxy for ">=1 trade" (Kalshi's
+# volume field is a running count of contracts traded and cannot be > 0 with zero prints).
+SETTLED_STATUSES = ("finalized", "settled")
+SETTLED_RESULTS = ("yes", "no")
+
+# KPI primary: markout at t+1h, reference = VWAP of prints in [t+1h, t+2h).
+MARKOUT_START_S = 3600.0
+MARKOUT_END_S = 7200.0
+
+# Kalshi maker fee (state assumption). Empirical /series survey on 2026-09-27 of every
+# series in the 3 target categories found exactly two fee_type values:
+#   "quadratic"                -> Kalshi's standard, taker-only schedule -> maker fee 0.
+#   "quadratic_with_maker_fees" -> makers are charged too.
+# Where charged: fee = ceil_to_cent(0.0175 * fee_multiplier * C * P * (1-P)) per print
+# (registry formula; fee_multiplier is the series' own API field, e.g. some series charge
+# at 0.5x). "also at 2x" means this whole fee (post-multiplier) doubled.
+MAKER_FEE_RATE = 0.0175
+NO_MAKER_FEE_TYPES = ("quadratic",)
+MAKER_FEE_TYPES = ("quadratic_with_maker_fees",)
+
+# Cap on prints read per sampled market, committed BEFORE any trade is fetched or KPI
+# computed (huge-volume-market rule required by the mission brief).
+CAP_PRINTS_PER_MARKET = 2000  # keep the first 2000 prints in chronological order
+
+# Pre-registered power assumptions (registry "power" block) -- for reporting only.
+ASSUMED_EFFECT_C = 0.95
+ASSUMED_SIGMA_MARKOUT_C = 3.0
+ASSUMED_SIGMA_SETTLEMENT_C = 45.0
+MARKETS_NEEDED_MARKOUT = 58
+EVENTS_NEEDED_SETTLEMENT = 12860
+
+MAX_TOP_DECILE_SHARE = 0.50
+
+
+def window_ts() -> tuple[int, int]:
+    """[start, end) as epoch seconds on Kalshi close_time; end is exclusive (day after WINDOW_END)."""
+    start = dt.datetime.combine(WINDOW_START, dt.time(), dt.timezone.utc)
+    end = dt.datetime.combine(WINDOW_END + dt.timedelta(days=1), dt.time(), dt.timezone.utc)
+    return int(start.timestamp()), int(end.timestamp())
