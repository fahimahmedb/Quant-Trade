+         {"odds_event_id": event_id, "sport": "basketball_nba", "commence_time": kickoff,
+          "venue": "POLYMARKET", "outcome": outcome, "market_id": market_id,
+          "token_id": f"tok-{outcome}", "best_bid": 0.5, "best_ask": 0.52}, observed_at)
