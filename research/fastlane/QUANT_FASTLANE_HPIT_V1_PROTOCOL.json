    "C0_usd": 100000.0,
    "allocation": "a_j = min(C0/slots, participation_cap_adv20 * ADV20_j); ADV20 = mean of raw_close*raw_volume over the 20 completed vendor sessions before entry",
    "alternative_audit_4_2": {
      "C0_usd": 10000.0,
      "slots": 20,
      "source": "audit §4.2 / FORM4_SLOT20_ADV20_V1 geometry"
    },
    "id": "FASTLANE_SLOTK_ADV20_V1",
    "no_recycling": "realized P&L is not recycled into C0",
    "order": "process entries by (entry_session, issuer_cik, accession-set digest); lowest free slot; if the issuer already holds an active slot or all slots are busy, a_j = 0 with the reason logged",
    "owner_decision_required": true,
    "rationale": "Power of the one-look holdout scales with concurrent positions, not event count: K=20 gives an annualized MDE of ~15%/yr on invested capital, K=100 ~7%/yr. C0 = USD 100,000 keeps a USD 1,000 slot so the USD 1 commission minimum costs 10 bp per side.",
    "slot_release": "time-based at the scheduled exit close; never early on gain, loss or delisting",
    "slot_target_notional": "C0 / slots",
    "slots": 100
  },
