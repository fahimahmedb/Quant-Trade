@@ -0,0 +1,118 @@
+"""Paper evaluation of the P7-B6 / H-014 shadow lane from the relay files only.
+
+    python3 scripts/b6_shadow_eval.py [--feeds data/feeds] [--out b6_report.json]
+
+Forward protocol (declared in research/praticiens/declarations_registre.jsonl before the
+first snapshot): for each market, the FIRST snapshot taken 40-60 minutes before expiry
+with a Hyperliquid mid and a closed DVOL candle; p* = N(d2) with sigma = DVOL/100 over
+the remaining minutes; buy YES if ask_yes + fee(ask_yes) < p*, NO if
+ask_no + fee(ask_no) < 1 - p*, fee = rate * p * (1 - p) from the market's own fee
+schedule; one share at the displayed best ask; hold to the official resolution.
+Statistic: net P&L per dollar, t clustered by (asset, expiry). Grid A (all) and B
+(0.15 <= price <= 0.85). Horizon: 12,194 grid-A trades or 2026-12-31; earlier reports
+are informative only. Verdict at the horizon: FORWARD_PASS if t >= required_t(2) with
+the same sign on BTC and ETH, else REJECT.
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import math
+import statistics
+from datetime import datetime, timezone
+from pathlib import Path
+
+REQUIRED_T_2_TRIALS = 2.241          # quant.factory.evaluate.required_t_statistic(2)
+HORIZON_TRADES, HORIZON_DATE = 12194, "2026-12-31"
+
+
+def read(base: Path) -> list[dict]:
+    items = []
+    for shard in sorted(base.glob("*.jsonl")) if base.is_dir() else []:
+        for line in shard.read_text(encoding="utf-8").splitlines():
+            try:
+                items.append(json.loads(line))
+            except json.JSONDecodeError:
+                continue
+    return items
+
+
+def fair_yes(spot: float, strike: float, dvol: float, minutes: float) -> float:
+    sigma, tau = dvol / 100.0, minutes / (365 * 24 * 60)
+    d2 = (math.log(spot / strike) - sigma * sigma * tau / 2) / (sigma * math.sqrt(tau))
+    return 0.5 * (1 + math.erf(d2 / math.sqrt(2)))
+
+
+def decisions(snapshots: list[dict], resolutions: dict[str, bool]) -> list[dict]:
+    first: dict[str, dict] = {}
+    for item in sorted(snapshots, key=lambda i: i["observed_at"]):
+        r = item["record"]
+        if not (40 <= (r.get("minutes_to_expiry") or -1) <= 60):
+            continue
+        if not r.get("hl_mid") or not (r.get("dvol") or {}).get("close"):
+            continue
+        first.setdefault(r["condition_id"], {**r, "observed_at": item["observed_at"]})
+    trades = []
+    for cid, r in first.items():
+        p_yes = fair_yes(r["hl_mid"], r["strike"], r["dvol"]["close"], r["minutes_to_expiry"])
+        rate = ((r.get("fee_schedule") or {}).get("rate")) or 0.07
+        for side, fair in (("yes", p_yes), ("no", 1 - p_yes)):
+            ask = ((r.get(f"{side}_book") or {}).get("best_ask"))
+            if ask is None or not 0 < ask < 1:
+                continue
+            fee = rate * ask * (1 - ask)
+            if ask + fee >= fair:
+                continue
+            won = resolutions.get(cid)
+            pnl = None if won is None else ((1.0 if (won if side == "yes" else not won) else 0.0)
+                                            - ask - fee) / (ask + fee)
+            trades.append({"cluster": f"{r['asset']}|{r['expiry_utc']}", "asset": r["asset"],
+                           "side": side, "price": ask, "fair": fair, "pnl": pnl,
+                           "observed_at": r["observed_at"]})
+    return trades
+
+
+def tstat(rows: list[dict]) -> dict:
+    by = collections.defaultdict(list)
+    for r in rows:
+        if r["pnl"] is not None:
+            by[r["cluster"]].append(r["pnl"])
+    means = [statistics.mean(v) for v in by.values()]
+    out = {"trades": sum(len(v) for v in by.values()), "clusters": len(means)}
+    if len(means) >= 3 and statistics.stdev(means) > 0:
+        out["mean_pnl_per_dollar"] = round(statistics.mean(means), 4)
+        out["t"] = round(statistics.mean(means) / (statistics.stdev(means) / math.sqrt(len(means))), 2)
+    return out
+
+
+def report(feeds: Path) -> dict:
+    snaps = read(feeds / "b6" / "snapshots")
+    res = {i["record"]["condition_id"]: i["record"]["yes_won"] for i in read(feeds / "b6" / "resolutions")}
+    trades = decisions(snaps, res)
+    grids = {"A": trades, "B": [t for t in trades if 0.15 <= t["price"] <= 0.85]}
+    out = {"generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+           "pristine_after": min((i["observed_at"] for i in snaps), default=None),
+           "snapshots": len(snaps), "resolved_markets": len(res),
+           "open_trades": sum(1 for t in trades if t["pnl"] is None)}
+    for name, rows in grids.items():
+        out[name] = {"all": tstat(rows), **{a: tstat([r for r in rows if r["asset"] == a])
+                                            for a in ("BTC", "ETH")}}
+    done = out["A"]["all"]["trades"] >= HORIZON_TRADES or out["generated_at"][:10] > HORIZON_DATE
+    a = out["A"]
+    same = all(a[x].get("mean_pnl_per_dollar", 0) * a["all"].get("mean_pnl_per_dollar", 0) > 0
+               for x in ("BTC", "ETH"))
+    out["status"] = ("horizon not reached (informative only)" if not done else
+                     "FORWARD_PASS" if a["all"].get("t", 0) >= REQUIRED_T_2_TRIALS and same else "REJECT")
+    return out
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--feeds", type=Path, default=Path(__file__).resolve().parents[1] / "data" / "feeds")
+    parser.add_argument("--out", type=Path, default=None)
+    args = parser.parse_args()
+    result = report(args.feeds)
+    if args.out:
+        args.out.write_text(json.dumps(result, indent=1), encoding="utf-8")
+    print(json.dumps(result, indent=1))
