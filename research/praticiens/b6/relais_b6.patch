--- /dev/null
+++ b/src/quant/dataplane/b6_relay.py
@@ -0,0 +1,162 @@
+"""B6 forward collector: Polymarket hourly crypto "above K" books + fair-value inputs.
+
+Research lane P7-B6 / H-014 (research/praticiens on claude/prompt-recherche-praticiens-dfy1l0):
+hourly BTC/ETH "above K" markets are 1-hour digital options; the shadow rule buys the
+side whose ask plus the taker fee is below p* = N(d2) computed from the Hyperliquid
+mid and the latest hourly Deribit DVOL. This module only COLLECTS, point in time:
+
+* ``b6/snapshots``: for every market of the event expiring ``WINDOW_MIN`` minutes
+  ahead, both order books (top 5 levels), the market's own fee schedule, and the
+  same-run inputs (Hyperliquid mid, last closed hourly DVOL candle);
+* ``b6/resolutions``: the official outcome of every snapshotted market, fetched once
+  it has closed.
+
+Everything is public and needs no key. Decisions, P&L and statistics are computed
+later by ``scripts/b6_shadow_eval.py`` from these files only.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from typing import Any, Callable, Iterator
+from zoneinfo import ZoneInfo
+
+from .adapters import DataUnavailable
+from .connectors import get_json, parse_order_book, _float
+
+ASSETS = {"bitcoin": "BTC", "ethereum": "ETH"}
+WINDOW_MIN = (40, 60)                 # books fill only once the last hour opens
+GAMMA_EVENT = "https://gamma-api.polymarket.com/events?slug={slug}"
+GAMMA_MARKETS = "https://gamma-api.polymarket.com/markets?{ids}&closed=true&limit=100"
+CLOB_BOOK = "https://clob.polymarket.com/book?token_id={token}"
+HL_INFO = "https://api.hyperliquid.xyz/info"
+DVOL = ("https://www.deribit.com/api/v2/public/get_volatility_index_data?currency={cur}"
+        "&start_timestamp={start}&end_timestamp={end}&resolution=3600")
+SNAPSHOTS, RESOLUTIONS = "b6/snapshots", "b6/resolutions"
+ET = ZoneInfo("America/New_York")
+
+
+def event_slug(asset: str, expiry_utc: datetime) -> str:
+    """``bitcoin-above-on-september-29-2026-6am-et`` for an expiry at 10:00 UTC (EDT)."""
+    local = expiry_utc.astimezone(ET)
+    hour = local.hour % 12 or 12
+    return (f"{asset}-above-on-{local.strftime('%B').lower()}-{local.day}-{local.year}"
+            f"-{hour}{'am' if local.hour < 12 else 'pm'}-et")
+
+
+def target_expiries(now: datetime) -> list[datetime]:
+    """Whole-hour expiries between ``WINDOW_MIN`` minutes ahead of ``now``."""
+    first = now.replace(minute=0, second=0, microsecond=0) + timedelta(hours=1)
+    lo, hi = (now + timedelta(minutes=m) for m in WINDOW_MIN)
+    return [first + timedelta(hours=h) for h in range(3) if lo <= first + timedelta(hours=h) <= hi]
+
+
+def parse_event(payload: Any, asset_code: str) -> list[dict[str, Any]]:
+    """Markets of one gamma event, with strike parsed from the question."""
+    out = []
+    for event in payload or []:
+        for m in event.get("markets") or []:
+            question = m.get("question") or ""
+            try:
+                strike = float(question.split(" above ")[1].split(" on ")[0].replace(",", ""))
+                tokens = json.loads(m.get("clobTokenIds") or "[]")
+                outcomes = json.loads(m.get("outcomes") or "[]")
+                yes = tokens[outcomes.index("Yes")]
+                no = tokens[outcomes.index("No")]
+            except (IndexError, ValueError, TypeError):
+                continue
+            out.append({"asset": asset_code, "event_slug": event.get("slug"),
+                        "condition_id": m.get("conditionId"), "question": question,
+                        "strike": strike, "end_date": m.get("endDate"),
+                        "yes_token": yes, "no_token": no,
+                        "fee_schedule": m.get("feeSchedule"), "fees_enabled": m.get("feesEnabled"),
+                        "accepting_orders": m.get("acceptingOrders")})
+    return out
+
+
+def top(book: dict[str, Any] | None, levels: int = 5) -> dict[str, Any] | None:
+    if not book:
+        return None
+    return {"best_bid": book["best_bid"], "best_ask": book["best_ask"],
+            "bids": book["bids"][:levels], "asks": book["asks"][:levels]}
+
+
+def last_closed_dvol(payload: Any, now: datetime) -> dict[str, Any] | None:
+    """Close of the latest hourly DVOL candle that has fully closed before ``now``."""
+    cutoff = now.timestamp() * 1000 - 3_600_000
+    rows = [r for r in ((payload or {}).get("result") or {}).get("data") or [] if r[0] <= cutoff]
+    if not rows:
+        return None
+    ts, *_, close = max(rows, key=lambda r: r[0])
+    return {"candle_start_ms": int(ts), "close": _float(close)}
+
+
+def parse_resolution(market: dict[str, Any]) -> dict[str, Any] | None:
+    if not market.get("closed"):
+        return None
+    try:
+        prices = [float(x) for x in json.loads(market.get("outcomePrices") or "[]")]
+        outcomes = json.loads(market.get("outcomes") or "[]")
+    except (ValueError, TypeError):
+        return None
+    if sorted(prices) != [0.0, 1.0] or "Yes" not in outcomes:
+        return None
+    return {"condition_id": market.get("conditionId"),
+            "yes_won": prices[outcomes.index("Yes")] == 1.0,
+            "uma_status": market.get("umaResolutionStatus")}
+
+
+def _read(out: Path, stream: str) -> list[dict[str, Any]]:
+    items = []
+    base = out / stream
+    for shard in sorted(base.glob("*.jsonl")) if base.is_dir() else []:
+        for line in shard.read_text(encoding="utf-8").splitlines():
+            try:
+                items.append(json.loads(line))
+            except json.JSONDecodeError:
+                continue
+    return items
+
+
+def collect(out: Path, now: datetime, *, get: Callable[..., Any] = get_json
+            ) -> Iterator[tuple[str, str, dict[str, Any]]]:
+    """Yield ``(stream, key, record)`` for one run (all share the caller's observed_at)."""
+    minute = now.strftime("%Y-%m-%dT%H:%M")
+    expiries = target_expiries(now)
+    if expiries:
+        mids = get(HL_INFO, method="POST", body={"type": "allMids"})
+        start = int((now - timedelta(hours=4)).timestamp() * 1000)
+        end = int(now.timestamp() * 1000)
+        dvol = {code: last_closed_dvol(get(DVOL.format(cur=code, start=start, end=end)), now)
+                for code in ASSETS.values()}
+        for expiry in expiries:
+            for asset, code in ASSETS.items():
+                markets = parse_event(get(GAMMA_EVENT.format(slug=event_slug(asset, expiry))), code)
+                for m in markets:
+                    books = {}
+                    for side in ("yes", "no"):
+                        try:
+                            books[side] = top(parse_order_book(
+                                get(CLOB_BOOK.format(token=m[f"{side}_token"])), "POLYMARKET",
+                                m[f"{side}_token"]))
+                        except DataUnavailable:
+                            books[side] = None
+                    yield SNAPSHOTS, f"{m['condition_id']}|{minute}", {
+                        **m, "expiry_utc": expiry.isoformat(), "minutes_to_expiry":
+                        round((expiry - now).total_seconds() / 60, 1),
+                        "yes_book": books["yes"], "no_book": books["no"],
+                        "hl_mid": _float((mids or {}).get(code)), "dvol": dvol[code]}
+    # resolutions for snapshotted markets that have closed and are not yet recorded
+    done = {item["key"] for item in _read(out, RESOLUTIONS)}
+    pending = sorted({item["record"]["condition_id"] for item in _read(out, SNAPSHOTS)
+                      if item["record"].get("end_date") and item["record"]["condition_id"] not in done
+                      and datetime.fromisoformat(item["record"]["end_date"].replace("Z", "+00:00"))
+                      < now - timedelta(minutes=30)})
+    for i in range(0, len(pending), 40):
+        ids = "&".join(f"condition_ids={cid}" for cid in pending[i:i + 40])
+        for market in get(GAMMA_MARKETS.format(ids=ids)) or []:
+            res = parse_resolution(market)
+            if res:
+                yield RESOLUTIONS, res["condition_id"], res
