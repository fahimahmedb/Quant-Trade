new file mode 100644
index 0000000..9aa4a2b
--- /dev/null
+++ b/tests/test_b6_relay.py
@@ -0,0 +1,92 @@
+"""Offline tests for the P7-B6 collector and shadow evaluator.
+
+Every number below is INVENTED for the tests (fixtures), not market data.
+"""
+import importlib.util
+import json
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+
+from quant.dataplane import b6_relay
+
+ROOT = Path(__file__).resolve().parents[1]
+_spec = importlib.util.spec_from_file_location("b6_shadow_eval", ROOT / "scripts" / "b6_shadow_eval.py")
+ev = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(ev)
+
+
+class SlugAndWindow(unittest.TestCase):
+    def test_slug_uses_new_york_time_and_year(self):
+        self.assertEqual(b6_relay.event_slug("bitcoin", datetime(2026, 9, 29, 10, tzinfo=timezone.utc)),
+                         "bitcoin-above-on-september-29-2026-6am-et")          # EDT, UTC-4
+        self.assertEqual(b6_relay.event_slug("ethereum", datetime(2026, 12, 1, 17, tzinfo=timezone.utc)),
+                         "ethereum-above-on-december-1-2026-12pm-et")          # EST, UTC-5
+
+    def test_window_selects_only_the_expiry_40_to_60_minutes_ahead(self):
+        at_17 = datetime(2026, 9, 29, 9, 17, tzinfo=timezone.utc)
+        self.assertEqual(b6_relay.target_expiries(at_17), [datetime(2026, 9, 29, 10, tzinfo=timezone.utc)])
+        at_47 = datetime(2026, 9, 29, 9, 47, tzinfo=timezone.utc)
+        self.assertEqual(b6_relay.target_expiries(at_47), [])                   # 13 and 73 min: both outside
+
+
+class Parsers(unittest.TestCase):
+    def test_parse_event_maps_yes_and_no_tokens_by_outcome_name(self):
+        payload = [{"slug": "s", "markets": [{"question": "Bitcoin above 84,000 on September 29, 7AM ET?",
+                                              "conditionId": "0xc", "endDate": "2026-09-29T11:00:00Z",
+                                              "clobTokenIds": '["n", "y"]', "outcomes": '["No", "Yes"]',
+                                              "feeSchedule": {"rate": 0.07}}]}]
+        m = b6_relay.parse_event(payload, "BTC")[0]
+        self.assertEqual((m["strike"], m["yes_token"], m["no_token"]), (84000.0, "y", "n"))
+
+    def test_dvol_uses_only_candles_closed_before_now(self):
+        now = datetime(2026, 9, 29, 9, 50, tzinfo=timezone.utc)
+        t9 = int(datetime(2026, 9, 29, 9, tzinfo=timezone.utc).timestamp() * 1000)
+        payload = {"result": {"data": [[t9 - 3_600_000, 1, 1, 1, 40.0], [t9, 1, 1, 1, 50.0]]}}
+        self.assertEqual(b6_relay.last_closed_dvol(payload, now)["close"], 40.0)   # 09:00 candle still open
+
+    def test_resolution_requires_a_closed_zero_one_outcome(self):
+        self.assertIsNone(b6_relay.parse_resolution({"closed": False}))
+        self.assertIsNone(b6_relay.parse_resolution({"closed": True, "outcomePrices": '["0.5","0.5"]',
+                                                     "outcomes": '["Yes","No"]'}))
+        r = b6_relay.parse_resolution({"closed": True, "conditionId": "c", "outcomePrices": '["0","1"]',
+                                       "outcomes": '["Yes","No"]'})
+        self.assertFalse(r["yes_won"])
+
+
+def snap(cid, minutes, ask_yes, ask_no, observed="2026-10-01T10:15:00+00:00", mid=100.0, strike=100.0):
+    return {"observed_at": observed, "record": {
+        "condition_id": cid, "asset": "BTC", "expiry_utc": "2026-10-01T11:00:00+00:00", "strike": strike,
+        "minutes_to_expiry": minutes, "hl_mid": mid, "dvol": {"close": 50.0}, "fee_schedule": {"rate": 0.07},
+        "yes_book": {"best_ask": ask_yes}, "no_book": {"best_ask": ask_no}}}
+
+
+class Evaluator(unittest.TestCase):
+    def test_at_the_money_fair_is_one_half(self):
+        self.assertAlmostEqual(ev.fair_yes(100, 100, 50, 60), 0.5, places=2)
+
+    def test_buys_only_when_ask_plus_fee_is_below_fair(self):
+        # ATM: fair ~ 0.4996 on both sides; 0.45 + fee(0.45)=0.4673 buys, 0.49 + 0.0175 does not.
+        trades = ev.decisions([snap("c", 55, 0.45, 0.49)], {"c": True})
+        self.assertEqual([t["side"] for t in trades], ["yes"])
+        self.assertAlmostEqual(trades[0]["pnl"], (1 - 0.45 - 0.07 * 0.45 * 0.55) / (0.45 + 0.07 * 0.45 * 0.55))
+
+    def test_ignores_snapshots_outside_the_window_and_keeps_the_first_inside(self):
+        s = [snap("c", 70, 0.10, 0.10, "2026-10-01T09:50:00+00:00"),        # too early: ignored
+             snap("c", 55, 0.45, 0.60, "2026-10-01T10:05:00+00:00"),
+             snap("c", 45, 0.01, 0.01, "2026-10-01T10:15:00+00:00")]        # later: never used
+        trades = ev.decisions(s, {})
+        self.assertEqual([(t["side"], t["price"], t["pnl"]) for t in trades], [("yes", 0.45, None)])
+
+    def test_unresolved_trades_do_not_enter_the_statistic(self):
+        rows = [{"cluster": "a", "pnl": None}, {"cluster": "b", "pnl": 0.1}]
+        self.assertEqual(ev.tstat(rows)["trades"], 1)
+
+    def test_report_on_empty_feeds_is_informative_only(self):
+        with tempfile.TemporaryDirectory() as d:
+            self.assertEqual(ev.report(Path(d))["status"], "horizon not reached (informative only)")
+
+
+if __name__ == "__main__":
+    unittest.main()
