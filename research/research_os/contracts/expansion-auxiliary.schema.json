{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-trade.local/contracts/expansion-auxiliary.schema.json",
  "title": "Research OS Final-Shape Auxiliary Records",
  "description": "Auxiliary records used by final-shape modules. They do not replace or redefine HypothesisContract, ResearchTask, ExperimentResult, EvidenceAssessment, CandidateEconomicIdentity, WorkerEvent, or WorkerReceipt.",
  "$defs": {
    "ImplementabilityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "status", "source_available", "pit_feasible", "expression_feasible", "cost_model_feasible", "capacity_observable", "operational_complexity", "blockers", "mechanism_rewritten", "research_decision_rewritten"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "PARK_IMPLEMENTABILITY", "BLOCK_IMPLEMENTABILITY"]},
        "source_available": {"oneOf": [{"type": "boolean"}, {"const": "UNKNOWN"}]},
        "pit_feasible": {"oneOf": [{"type": "boolean"}, {"const": "UNKNOWN"}]},
        "expression_feasible": {"oneOf": [{"type": "boolean"}, {"const": "UNKNOWN"}]},
        "cost_model_feasible": {"oneOf": [{"type": "boolean"}, {"const": "UNKNOWN"}]},
        "capacity_observable": {"oneOf": [{"type": "boolean"}, {"const": "UNKNOWN"}]},
        "operational_complexity": {"type": "string"},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "implementability_status": {"enum": ["IMPLEMENTABLE", "PARK_IMPLEMENTABILITY", "BLOCK_IMPLEMENTABILITY"]},
        "exact_expression_status": {"enum": ["PASS", "BLOCK", "UNKNOWN"]},
        "exact_clock_status": {"enum": ["PASS", "BLOCK", "UNKNOWN"]},
        "exact_universe_status": {"enum": ["PASS", "BLOCK", "UNKNOWN"]},
        "exact_expression_contract": {"type": ["object", "null"]},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_mutated": {"const": false},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["economic_experiment_authorized", "prospective_observation_authorized", "real_capital_authorized", "live_trading_authorized"],
          "properties": {
            "economic_experiment_authorized": {"const": false},
            "prospective_observation_authorized": {"const": false},
            "real_capital_authorized": {"const": false},
            "live_trading_authorized": {"const": false}
          }
        },
        "economic_experiment_authorized": {"const": false},
        "prospective_observation_authorized": {"const": false},
        "real_capital_authorized": {"const": false},
        "live_trading_authorized": {"const": false},
        "mechanism_rewritten": {"const": false},
        "research_decision_rewritten": {"const": false}
      }
    },
    "ExperimentEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "hypothesis_generation", "status", "protocol_hash", "dataset_provenance", "cost_model_version", "code_version", "outcome_opened", "observed_attempts", "effective_trials_status", "estimated_effective_trials", "result", "immutable_generation"],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "hypothesis_generation": {"type": "string", "minLength": 1},
        "status": {"enum": ["FROZEN_READY_NO_OUTCOME", "NOT_FROZEN_BY_IMPLEMENTABILITY"]},
        "protocol_hash": {"type": ["string", "null"]},
        "protocol_payload": {"type": ["object", "null"]},
        "dataset_provenance": {"type": "object"},
        "cost_model_version": {"type": "string"},
        "code_version": {"type": "string"},
        "outcome_opened": {"const": false},
        "observed_attempts": {"type": "integer", "minimum": 0},
        "effective_trials_status": {"enum": ["UNKNOWN", "KNOWN", "ESTIMATED"]},
        "estimated_effective_trials": {"type": ["number", "null"], "minimum": 0},
        "result": {"type": "string"},
        "immutable_generation": {"const": true}
      }
    },
    "ForwardRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prospective_contract_id", "hypothesis_id", "generation_id", "protocol_hash", "readiness", "observation_authorization", "observation_started", "future_outcomes_consumed", "material_change_requires_new_generation"],
      "properties": {
        "prospective_contract_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "generation_id": {"type": "string", "minLength": 1},
        "protocol_hash": {"type": ["string", "null"]},
        "readiness": {"enum": ["READY_AWAITING_OWNER_AUTHORITY", "NOT_READY"]},
        "observation_authorization": {"enum": ["NOT_AUTHORIZED", "AUTHORIZED_FOR_EXACT_SCOPE"]},
        "observation_started": {"type": "boolean"},
        "future_outcomes_consumed": {"type": "integer", "minimum": 0},
        "material_change_requires_new_generation": {"const": true}
      }
    },
    "DecayAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "status", "registrations_seen", "observations_consumed", "decay_decisions_emitted"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "status": {"enum": ["INACTIVE_BY_AUTHORITY", "ACTIVE"]},
        "registrations_seen": {"type": "integer", "minimum": 0},
        "observations_consumed": {"type": "integer", "minimum": 0},
        "decay_decisions_emitted": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/ImplementabilityAssessment"},
    {"$ref": "#/$defs/ExperimentEnvelope"},
    {"$ref": "#/$defs/ForwardRegistration"},
    {"$ref": "#/$defs/DecayAssessment"}
  ]
}
